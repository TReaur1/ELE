(* ════════════════════════════════════════════════════════════════════
   SBR_08 主调度 (主程序 main)
   调用规范: SBR 子程序在 main 中以 sbr_xxx(); 空括号方式调用 (无参数)
   各层只读写全局变量表, 互不直接调用
   扫描顺序: IO(STEP0) -> 安全回路(STEP1 最先逻辑) -> 模式(STEP2)
             -> 手动(STEP3) -> 自动(STEP4) -> 轴控制与输出(STEP5 最后刷新)
   无许可(RunOK=FALSE)时强制安全态
   ════════════════════════════════════════════════════════════════════ *)

sbr_io();        (* STEP 0: IO 映射 - 急停不滤波, 物料/限位 20ms 滤波 *)
sbr_safety();    (* STEP 1: 安全回路 - 锁存/复位/许可/看门狗/三色灯 *)
sbr_mode();      (* STEP 2: 模式管理 - 手动/自动互斥, 切换检测, 清零 *)
sbr_manual();    (* STEP 3: 手动控制 - Jog/步进/辊筒 手动 *)
sbr_auto();      (* STEP 4: 自动控制 - 握手/查表/定时/超时/反馈 *)
sbr_axis();      (* STEP 5: 轴控制与输出 - 伺服FB/步进FB/辊筒FB, 最后写物理端子 *)
