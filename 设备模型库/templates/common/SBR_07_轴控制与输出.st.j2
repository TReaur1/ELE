(* ════════════════════════════════════════════════════════════════════
   SBR_07 轴控制与输出 - {{ project.name }}
   伺服FB / 步进FB / 辊筒FB + 最后写物理端子 + 急停安全切断
   ════════════════════════════════════════════════════════════════════ *)
{%- for s in actuators.servos %}

(* {{ s.name_cn }} 伺服FB调用: {{ s.fb_instance }} *)
(* R3b: 命令实体全成员传参 (14命令接口完整通路) *)
{{ s.fb_instance }}(Axis := {{ s.axis_handle }},
    PowerEnable := {{ s.cmd_struct }}.PowerEnable,
    Stop := {{ s.cmd_struct }}.Stop,
    Reset := {{ s.cmd_struct }}.Reset,
    Home := {{ s.cmd_struct }}.Home,
    JogForward := {{ s.cmd_struct }}.JogForward,
    JogBackward := {{ s.cmd_struct }}.JogBackward,
    Jogvelocity := {{ s.cmd_struct }}.Jogvelocity,
    JogAcceleration := {{ s.cmd_struct }}.JogAcceleration,
    JogDeceleration := {{ s.cmd_struct }}.JogDeceleration,
    Absolute_Execute := {{ s.cmd_struct }}.Absolute_Execute,
    Absolute_Position := {{ s.cmd_struct }}.Absolute_Position,
    Absolute_Velocity := {{ s.cmd_struct }}.Absolute_Velocity,
    Absolute_Acceleration := {{ s.cmd_struct }}.Absolute_Acceleration,
    Absolute_Deceleration := {{ s.cmd_struct }}.Absolute_Deceleration,
    Timeout := TIMEOUT_AXIS_MOVE,
    Absolute_MoveAbsoluteDone => {{ s.status_struct }}.MoveAbsolute.Done,
    AxisStatusData => {{ s.status_struct }});
{%- endfor %}
{%- for sp in actuators.steppers %}

(* {{ sp.name_cn }} 步进: {{ sp.fb_instance }} *)
{{ sp.fb_instance }}(ManForward := {{ sp.fb_instance }}.ManForward, ManBackward := {{ sp.fb_instance }}.ManBackward,
    Enable := con_RunOK, Stop := con_EstopPressed);
{%- endfor %}
