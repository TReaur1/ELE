(* ════════════════════════════════════════════════════════════════════
   SBR_08 主调度 (主程序 main) - virtual_project
   PLC: H5U  通讯: ModbusTCP  原型: host_driven
   调用规范: SBR 子程序在 main 中以 sbr_xxx(); 空括号方式调用 (无参数)
   各层只读写全局变量表, 互不直接调用
   扫描顺序: IO(STEP0) -> 安全回路(STEP1 最先逻辑) -> 模式(STEP2)
             -> 通讯主站(STEP3 通讯健康/急停注销) -> 手动(STEP4)
             -> 自动(STEP5) -> 轴控制与输出(STEP6) -> 状态呈现(STEP7 最后对外)
   无许可(RunOK=FALSE)时强制安全态
   ════════════════════════════════════════════════════════════════════ *)

sbr_io();        (* STEP 0: IO 映射 - 急停不滤波, 物料/限位 内置滤波 *)
sbr_safety();    (* STEP 1: 安全回路 - 锁存/复位/许可/报警字汇编/急停活跃 *)
sbr_mode();      (* STEP 2: 模式管理 - 手动/自动互斥, 切换检测, 清零 *)
sbr_host();      (* STEP 3: 通讯主站 - 三级看门狗/出向心跳/恢复沿清序号/急停注销 *)
sbr_manual();    (* STEP 4: 手动控制 - Jog/步进/辊筒 手动 *)
sbr_auto();      (* STEP 5: 自动控制 - 握手/查表/定时/超时/反馈 *)
sbr_axis();      (* STEP 6: 轴控制与输出 - 伺服FB/步进FB/辊筒FB, 最后写物理端子 *)
sbr_status();    (* STEP 7: 状态呈现 - 上位机状态区回写, 一切对外呈现 *)