    {
      "var_name": "host_Send_Cross_Start",
      "name_cn": "横移定位启动",
      "data_type": "INT",
      "d_addr": 1,
      "comment": "写完位置号后写1触发,读到到位后写0"
    },
    {
      "var_name": "host_Send_Rot_PosNo",
      "name_cn": "旋转位置号",
      "data_type": "INT",
      "d_addr": 2,
      "comment": "M2旋转目标位置号(1~5)"
