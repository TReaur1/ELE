(* ════════════════════════════════════════════════════════════════════
   SBR_02 IO 映射 —— 输入映像 (汇川 ST 显式映射)
   ════════════════════════════════════════════════════════════════════
   风格: 物理点 -> 逻辑变量 单向映像; io 表变量不直接绑定地址,
         地址对照以本块与 SBR_07 输出映像代码为唯一真源。
   滤波: X0 急停最短滤波/直通(安全响应最快); 其余内置滤波约10ms。
   硬件: 本体 X0~X7; 输出扩展模块 Y10~Y13(见 SBR_07 输出映像)。

   地址对照:
     X0 in_eStop     急停按钮 常闭(TRUE=释放)
     X1 in_Reset     复位按钮 常开
     X2 in_ModeAuto  手自动旋钮 常开(TRUE=自动位)
     X3 in_Pos1Sns   位置检测1 光电 进料段
     X4 in_Pos2Sns   位置检测2 光电 中段
     X5 in_Pos3Sns   位置检测3 光电 出料段
     X6 in_CylUpSns  阻挡升到位磁开
     X7 in_CylDnSns  阻挡降到位磁开
   ════════════════════════════════════════════════════════════════════ *)

(* ── 输入映像: 物理输入 -> 逻辑变量 ── *)
in_eStop    := X0;
in_Reset    := X1;
in_ModeAuto := X2;
in_Pos1Sns  := X3;
in_Pos2Sns  := X4;
in_Pos3Sns  := X5;
in_CylUpSns := X6;
in_CylDnSns := X7;

(* 输出映像(Y0~Y13)见 SBR_07 末段; COM0 RS485 主站配置说明见工程设备配置 *)
